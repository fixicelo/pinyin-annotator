{
  "name": "pinyin-annotator",
  "displayName": "Pinyin Annotator",
  "version": "1.8.1",
  "description": "A browser extension overlays Pinyin or Zhuyin annotations over Chinese characters present in web pages and video closed captions.",
  "author": "fixicelo <fixicelo@gmail.com>",
  "scripts": {
    "dev": "plasmo dev",
    "clean": "rm -rf build",
    "build": "pnpm run clean && plasmo build",
    "package": "plasmo package",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:firefox": "web-ext run --source-dir ./build/firefox-mv3-prod/",
    "i18n:sync": "node scripts/generate-i18n-fallback.mjs && prettier --write src/lib/i18n-fallback.ts && node scripts/check-locales.mjs",
    "predev": "node scripts/generate-i18n-fallback.mjs && prettier --write src/lib/i18n-fallback.ts",
    "prebuild": "pnpm run i18n:sync",
    "prepackage": "pnpm run i18n:sync",
    "build:all": "pnpm run i18n:sync && pnpm run clean && plasmo build --target=chrome-mv3 && plasmo build --target=firefox-mv3",
    "package:all": "pnpm run i18n:sync && pnpm run clean && plasmo build --target=chrome-mv3 && plasmo build --target=firefox-mv3 && plasmo package --target=chrome-mv3 && plasmo package --target=firefox-mv3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fixicelo/pinyin-annotator.git"
  },
  "dependencies": {
    "@pinyin-pro/data": "^1.3.1",
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "cnchar": "^3.2.6",
    "cnchar-poly": "^3.2.6",
    "cnchar-trad": "^3.2.6",
    "pinyin-pro": "^3.28.2",
    "plasmo": "^0.90.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/chrome": "^0.2.5",
    "@types/filesystem": "^0.0.36",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "manifest": {
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "default_locale": "en",
    "permissions": [
      "activeTab",
      "scripting",
      "storage",
      "contextMenus"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "pinyin-annotator@fixicelo.ext",
        "data_collection_permissions": {
          "required": [
            "none"
          ]
        }
      }
    },
    "commands": {
      "toggle-annotation": {
        "suggested_key": {
          "default": "Alt+Shift+P",
          "mac": "Alt+Shift+P"
        },
        "description": "__MSG_commandToggleDescription__"
      }
    }
  }
}
